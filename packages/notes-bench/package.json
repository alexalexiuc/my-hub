{
  "name": "@my-hub/notes-bench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "pnpm exec eslint src",
    "test:unit": "vitest run --passWithNoTests",
    "fixtures": "tsx src/build-fixtures.ts",
    "bench": "tsx src/cli.ts all",
    "bench:embed": "tsx src/cli.ts embed",
    "bench:write": "tsx src/cli.ts write",
    "bench:search": "tsx src/cli.ts search",
    "bench:relevance": "tsx src/cli.ts relevance",
    "bench:seed": "tsx src/cli.ts seed",
    "bench:compare": "tsx src/cli.ts compare"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@my-hub/notes": "workspace:*",
    "@my-hub/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
