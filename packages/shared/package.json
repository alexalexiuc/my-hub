{
  "name": "@my-hub/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./dist/db/schema/index.d.ts",
      "import": "./dist/db/schema/index.js",
      "require": "./dist/db/schema/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./db": {
      "types": "./dist/db/client.d.ts",
      "import": "./dist/db/client.js",
      "require": "./dist/db/client.cjs"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js",
      "require": "./dist/services/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "require": "./dist/constants/index.cjs"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "require": "./dist/schemas/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:clear": "rimraf dist",
    "lint": "pnpm exec eslint src",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1021.0",
    "@aws-sdk/client-ses": "^3.1023.0",
    "airports-data": "^1.4.0",
    "drizzle-orm": "^0.30.10",
    "jose": "^6.2.2",
    "juice": "^11.1.1",
    "postgres": "^3.4.4",
    "promise-cachex": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "dotenv-mono": "^1.5.1",
    "drizzle-kit": "^0.21.4",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
