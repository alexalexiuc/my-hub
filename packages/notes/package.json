{
  "name": "@my-hub/notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "notes-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "build:clear": "rimraf dist",
    "lint": "pnpm exec eslint src",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@my-hub/shared": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
