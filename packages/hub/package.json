{
  "name": "@my-hub/hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clear": "rimraf dist .next",
    "start": "next start",
    "start:standalone": "bash scripts/start-hub-standalone.sh",
    "start:standalone:skip-build": "bash scripts/start-hub-standalone.sh --skip-build",
    "lint": "pnpm exec eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "healthcheck": "node scripts/healthcheck.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen:palettes": "tsx scripts/gen-palettes.mts",
    "gen:palettes:report": "tsx scripts/gen-palettes.mts --report",
    "gen:palettes:check": "tsx scripts/gen-palettes.mts && git diff --exit-code -- src/styles/themes.generated.css src/lib/theme-swatches.generated.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@my-hub/shared": "workspace:*",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "clsx": "^2.1.1",
    "fuse.js": "^7.3.0",
    "jose": "^6.2.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "mitt": "^3.0.1",
    "next": "~16.1.6",
    "next-auth": "^4.24.7",
    "papaparse": "^5.5.3",
    "promise-cachex": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/culori": "^4.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^22.13.14",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "culori": "^4.0.2",
    "dotenv-mono": "^1.5.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "storybook": "^10.3.5",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
