{
  "name": "@my-hub/hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clear": "rimraf dist .next",
    "start": "next start",
    "start:standalone": "bash scripts/start-hub-standalone.sh",
    "start:standalone:skip-build": "bash scripts/start-hub-standalone.sh --skip-build",
    "lint": "pnpm exec eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "healthcheck": "node scripts/healthcheck.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen:palettes": "tsx scripts/gen-palettes.mts",
    "gen:palettes:report": "tsx scripts/gen-palettes.mts --report",
    "gen:palettes:check": "tsx scripts/gen-palettes.mts && git diff --exit-code -- src/styles/themes.generated.css src/lib/theme-swatches.generated.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@my-hub/shared": "workspace:*",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "mitt": "^3.0.1",
    "next": "~16.3.6",
    "next-auth": "^4.24.15",
    "papaparse": "^5.7.0",
    "promise-cachex": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/maplibre-gl": "^1.14.0",
    "@types/node": "^24.13.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "culori": "^4.0.2",
    "dotenv-mono": "^1.5.1",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "storybook": "^10.6.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
