NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Session management
SESSION_CLEANUP_INTERVAL_MS=300000
SESSION_MAX_IDLE_MS=1800000

# Database (required — no MCP auth without DB)
DATABASE_URL=postgresql://myhub:change_me@localhost:5432/myhub

# OAuth (required for NextAuth consent page)
NEXTAUTH_SECRET=change_me_32_char_random_string

# Encryption key (required for tokenSigningSecret at-rest encryption)
ENCRYPTION_KEY=change_me_strong_random_base64_key

# Comma-separated emails allowed to authorize via /authorize
ALLOWED_EMAILS=alex@example.com
