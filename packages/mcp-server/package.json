{
  "name": "@my-hub/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsup",
    "build:clear": "rimraf dist",
    "start": "node dist/main.js",
    "lint": "pnpm exec eslint src",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "e2e:setup": "tsx e2e/scripts/setup-e2e-db.ts",
    "kill:port": "node scripts/kill-port.js",
    "healthcheck": "node scripts/healthcheck.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@my-hub/shared": "workspace:*",
    "close-with-grace": "^2.0.0",
    "dotenv-mono": "^1.5.1",
    "fastify": "^5.12.5",
    "fastify-mcp-server": "^0.7.0",
    "fastify-plugin": "^6.0.0",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.12",
    "pino-pretty": "^13.0.0",
    "promise-cachex": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.1",
    "nodemon": "^3.1.14",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
