{
  "name": "@my-hub/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsup",
    "build:clear": "rimraf dist",
    "start": "node dist/main.js",
    "lint": "pnpm exec eslint src",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "e2e:setup": "tsx e2e/scripts/setup-e2e-db.ts",
    "kill:port": "node scripts/kill-port.js",
    "healthcheck": "node scripts/healthcheck.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@my-hub/shared": "workspace:*",
    "close-with-grace": "^2.0.0",
    "dotenv-mono": "^1.5.1",
    "fastify": "^5.8.2",
    "fastify-mcp-server": "^0.7.0",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.2",
    "pino-pretty": "^13.0.0",
    "promise-cachex": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@vitest/coverage-v8": "^4.1.5",
    "vite": "^6.0.0",
    "nodemon": "^3.1.14",
    "tsup": "^8.0.0",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.5"
  }
}
