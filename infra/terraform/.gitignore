# Terraform state — contains resource IDs and sensitive data, never commit
terraform.tfstate
terraform.tfstate.backup
.terraform.tfstate.lock.info

# Provider binaries and cached modules (auto-downloaded via terraform init)
.terraform/

# Actual secrets file — copy terraform.tfvars.example to terraform.tfvars and fill in
terraform.tfvars

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
