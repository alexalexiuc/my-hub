{
  "$schema": "https://v2-11-3.turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", "prettier.config.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@my-hub/hub#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/server/**", ".next/static/**", "!.next/cache/**", "!.next/dev/**", "!.next/standalone/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "build:clear": {
      "cache": false
    }
  }
}
