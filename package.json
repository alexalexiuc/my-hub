{
  "name": "my-hub",
  "version": "0.0.0",
  "private": true,
  "author": "Alexiuc Alex",
  "scripts": {
    "dev": "turbo dev",
    "dev:hub": "turbo dev --filter=@my-hub/hub",
    "build": "turbo build",
    "build:shared": "pnpm --filter shared build",
    "build:clear": "turbo build:clear",
    "lint": "turbo lint",
    "lint:fix": "pnpm exec eslint . --fix",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "pnpm run test:unit",
    "test:unit": "turbo test:unit",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:e2e:staging": "node infra/scripts/e2e-staging.mjs",
    "start:prod": "docker compose --project-name my-hub --env-file .env -f infra/docker-compose.prod.yml up -d --remove-orphans",
    "start:local": "docker compose --project-name my-hub-local --env-file .env -f infra/docker-compose.local.yml up -d --build --remove-orphans",
    "logs:server": "node infra/scripts/server-compose-logs.mjs",
    "logs:server:prod": "node infra/scripts/server-compose-logs.mjs --env prod",
    "logs:server:staging": "node infra/scripts/server-compose-logs.mjs --env staging",
    "db:generate": "pnpm --filter shared db:generate",
    "db:migrate": "pnpm --filter shared db:migrate",
    "prepare": "husky",
    "lint:timing": "cross-env TIMING=1 eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@types/node": "^22.13.14",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.3",
    "eslint-config-flat-gitignore": "^2.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.0.0",
    "turbo": "^2.9.6",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.57.0"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "dependencies": {
    "dotenv-mono": "^1.5.1"
  },
  "lint-staged": {
    "**/*.{ts,tsx,mjs,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
