{
  "name": "my-hub",
  "version": "0.0.0",
  "private": true,
  "author": "Alexiuc Alex",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm --filter @my-hub/shared build && pnpm --filter @my-hub/mcp-server build && pnpm --filter @my-hub/hub build",
    "build:clear": "pnpm -r build:clear",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "pnpm run build && pnpm --filter @my-hub/shared typecheck && pnpm --filter @my-hub/mcp-server typecheck && pnpm --filter @my-hub/hub typecheck",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "start:prod": "docker compose --project-name my-hub-prod --env-file .env -f infra/docker-compose.prod.yml up -d --remove-orphans",
    "start:local": "docker compose --project-name my-hub-local --env-file .env -f infra/docker-compose.local.yml up -d --build --remove-orphans",
    "logs:server": "node infra/scripts/server-compose-logs.mjs",
    "logs:server:prod": "node infra/scripts/server-compose-logs.mjs --env prod",
    "logs:server:staging": "node infra/scripts/server-compose-logs.mjs --env staging",
    "db:generate": "pnpm --filter shared db:generate",
    "db:migrate": "pnpm --filter shared db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@types/node": "^22.13.14",
    "eslint": "^10.0.3",
    "eslint-config-flat-gitignore": "^2.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "dependencies": {
    "dotenv-mono": "^1.5.1"
  }
}
