# Root .env.example — copy to .env and fill in values before running docker compose
# Never commit .env to source control

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=myhub
POSTGRES_USER=myhub
POSTGRES_PASSWORD=change_me_strong_password

# ── MCP Server ──────────────────────────────────────────────────────────────
# Assembled automatically from POSTGRES_* above inside docker-compose.yml
# Override here only if you want a custom connection string
# DATABASE_URL=postgresql://myhub:change_me@localhost:5432/myhub

LOG_LEVEL=info

# ── Admin (Next.js / NextAuth.js) ───────────────────────────────────────────
NEXTAUTH_URL=https://hub.alexiuc.dev
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_32_char_random_string

GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Comma-separated GitHub usernames allowed to log in to the admin panel
ALLOWED_GITHUB_USERS=alexiuc

# ── Required GitHub Secrets for CI/CD ───────────────────────────────────────
# VPS_HOST       — IP or hostname of the production VPS
# VPS_USER       — SSH user (e.g. ubuntu)
# VPS_SSH_KEY    — private SSH key (RSA/Ed25519) with newlines preserved
