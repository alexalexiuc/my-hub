# Root .env.example — copy to .env and fill in values before running docker compose
# Never commit .env to source control
# Used by local development too (dotenv-mono loads this file from packages/*)

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=myhub
POSTGRES_USER=myhub
POSTGRES_PASSWORD=change_me_strong_password

# ── MCP Server ──────────────────────────────────────────────────────────────
# Assembled automatically from POSTGRES_* above inside docker-compose.yml
# Override here only if you want a custom connection string
# For local dev (pnpm dev), set DATABASE_URL explicitly:
DATABASE_URL=postgresql://myhub:change_me@localhost:5432/myhub

# Used by docker-compose.local.yml when the DB runs on the host (not in Docker):
# DATABASE_URL_DOCKER=postgresql://myhub:change_me@host.docker.internal:5432/myhub

MCP_SERVER_PORT=3001
MCP_HOST=0.0.0.0
# Host-header allowlist (hostnames, comma-separated) for the /api/*/mcp endpoints — DNS-rebinding protection.
# Defaults to localhost,127.0.0.1,[::1]; deployed environments must list the public MCP domain.
# MCP_ALLOWED_HOSTS=mcp.alexiuc.dev
# Origin allowlist (hostnames) for browser MCP clients; requests without an Origin header always pass.
# Defaults to localhost,127.0.0.1,[::1],claude.ai,claude.com
# MCP_ALLOWED_ORIGINS=
CORS_ORIGIN=http://localhost:3000
# Comma-separated list of allowed OAuth redirect URIs (exact match or prefix).
# If unset, any HTTPS URI or localhost is accepted.
# Production: ALLOWED_REDIRECT_URIS=https://claude.ai/api/auth/mcp/callback
ALLOWED_REDIRECT_URIS=

LOG_LEVEL=info

# Request logging — set LOG_PAYLOADS=true to store full request/response bodies in DB (off by default)
LOG_PAYLOADS=false
# Set PRINT_PAYLOADS=true to print request payloads to stdout (may include sensitive data)
PRINT_PAYLOADS=false

# ── Hub (Next.js / NextAuth.js) ─────────────────────────────────────────────
# Public base URL of the Hub. Used by worker and hub routes to build email
# links and unsubscribe URLs. Usually the same value as NEXTAUTH_URL.
# Local dev: http://localhost:3000
# Production: https://hub.alexiuc.dev
HUB_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_32_char_random_string

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Comma-separated emails allowed to log in to the admin panel
ALLOWED_EMAILS=alex@example.com

# Public MCP server base URL — used by the hub UI (mcp-control page)
# Local dev: http://localhost:3001
# Production: https://mcp.alexiuc.dev
NEXT_PUBLIC_MCP_URL=http://localhost:3001

# ── Travel file storage (Hub uploads) ──────────────────────────────────────
# Absolute container path used by Hub for uploaded trip documents.
# Must match the mounted volume path in docker-compose files.
TRAVEL_FILES_ROOT=/app/data/travel-documents
# Maximum upload size in MB for a single document.
TRAVEL_FILES_MAX_MB=15
# Comma-separated allowlist of MIME types.
TRAVEL_FILES_ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/webp

# ── Notes MCP (docs/notes-mcp-spec.md) ───────────────────────────────────────
# Own Postgres with pgvector (docker: the `notes-db` service). Disposable search index; rebuilt from the files.
NOTES_DB_PASSWORD=change_me_notes_db_password
# Local dev (pnpm dev): point at any Postgres that has the vector, pg_trgm and unaccent extensions.
# NOTES_DATABASE_URL=postgres://notes:change_me_notes_db_password@localhost:5433/notes
# Markdown repos live here, one git repo per user: <NOTES_ROOT>/<userId>/
# NOTES_ROOT=./data/notes
# e5 = multilingual-e5-small in-process (default), ollama, or fake (tests only; no semantic search).
# EMBEDDINGS_PROVIDER=e5
# EMBEDDINGS_MODEL=
# EMBEDDINGS_DIMENSIONS=            # required for ollama (bge-m3: 1024); fake defaults to 384
# EMBEDDINGS_CACHE_DIR=./data/model-cache
# EMBEDDINGS_LOCAL_MODEL_PATH=      # pre-seeded weights dir; disables downloads
# OLLAMA_URL=http://ollama:11434
# NOTES_WARM_ON_BOOT=true           # load the model at boot, not on the first call
# NOTES_GIT_REMOTE=git@github.com:you/notes-backup.git   # optional private backup repo
# NOTES_MATCH_THRESHOLD=0.6         # remember(): minimum score to append to an existing note
# NOTES_MATCH_VECTOR_FLOOR=0.8      # cosine below this does not count towards a match
# NOTES_RRF_K=60
# Compose resource limits for the mcp container (mirror the VPS so benchmark numbers compare).
# MCP_CPUS=2
# MCP_MEM_LIMIT=2g

# ── App Secrets ──────────────────────────────────────────────────────────────
ENCRYPTION_KEY=change_me_strong_random_base64_key

# ── Production deploy ────────────────────────────────────────────────────────
# GitHub Container Registry owner (your GitHub username or org)
# Required by docker-compose.prod.yml to pull images: ghcr.io/<IMAGE_OWNER>/...
IMAGE_OWNER=your_github_username

# ── CI/CD GitHub Secrets (not used locally) ─────────────────────────────────
# VPS_HOST       — IP or hostname of the production VPS
# VPS_USER       — SSH user (e.g. ubuntu)
# VPS_SSH_KEY    — private SSH key (RSA/Ed25519) with newlines preserved

# ── E2E Tests For local host only ───────────────────────────────────────────
# Marks this as a local machine — enables file writes in scripts like e2e:setup
# Never set this in Docker or CI environments
IS_LOCAL=false

# RapidAPI key for flight data APIs
RAPIDAPI_KEY=your_rapidapi_key_for_travel_data

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=your-db-backup-bucket-name
S3_LOGS_BUCKET=your-logs-bucket-name
# Path where /var/lib/docker/containers is mounted read-only in the worker container.
# Used by the daily log-backup task to upload Docker json-file logs to S3 (logs/<date>/<name>.log.gz).
DOCKER_LOGS_DIR=/host/containers

# SES Configs
SES_FROM_EMAIL=email@address.com

# Secret for generating unsubscribe links in weekly report emails
UNSUBSCRIBE_SECRET=change_me_random_string_for_unsubscribe_links
EMAIL_VERIFICATION_SECRET=change_me_random_string_for_email_verification

# E2E_HUB_BASE_URL=http://localhost:3000
# E2E_HUB_USER_EMAIL=e2e-hub@test.local
# E2E_HUB_USER_PASSWORD=your-e2e-test-user-password
# E2E_MCP_USER_EMAIL=e2e-mcp@test.local
# E2E_MCP_CLIENT_ID=e2e_test_client_id
# E2E_MCP_CLIENT_SECRET=e2e_test_client_secret
