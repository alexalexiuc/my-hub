# Root .env.example — copy to .env and fill in values before running docker compose
# Never commit .env to source control
# Used by local development too (dotenv-mono loads this file from packages/*)

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=myhub
POSTGRES_USER=myhub
POSTGRES_PASSWORD=change_me_strong_password

# ── MCP Server ──────────────────────────────────────────────────────────────
# Assembled automatically from POSTGRES_* above inside docker-compose.yml
# Override here only if you want a custom connection string
# For local dev (pnpm dev), set DATABASE_URL explicitly:
DATABASE_URL=postgresql://myhub:change_me@localhost:5432/myhub

# Used by docker-compose.local.yml when the DB runs on the host (not in Docker):
# DATABASE_URL_DOCKER=postgresql://myhub:change_me@host.docker.internal:5432/myhub

MCP_PORT=3001
MCP_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# Comma-separated list of allowed OAuth redirect URIs (exact match or prefix).
# If unset, any HTTPS URI or localhost is accepted.
# Production: ALLOWED_REDIRECT_URIS=https://claude.ai/api/auth/mcp/callback
ALLOWED_REDIRECT_URIS=

LOG_LEVEL=info

# Session cleanup configuration
SESSION_CLEANUP_INTERVAL_MS=300000
SESSION_MAX_IDLE_MS=1800000

# Request logging — set LOG_PAYLOADS=true to store full request/response bodies in DB (off by default)
LOG_PAYLOADS=false
# Set PRINT_PAYLOADS=true to print request payloads to stdout (may include sensitive data)
PRINT_PAYLOADS=false

# ── Hub (Next.js / NextAuth.js) ─────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://hub.alexiuc.dev
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change_me_32_char_random_string

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Comma-separated emails allowed to log in to the admin panel
ALLOWED_EMAILS=alex@example.com

# Public MCP server base URL — used by the hub UI (mcp-control page)
# Local dev: http://localhost:3001
# Production: https://mcp.alexiuc.dev
NEXT_PUBLIC_MCP_URL=http://localhost:3001

# ── Travel file storage (Hub uploads) ──────────────────────────────────────
# Absolute container path used by Hub for uploaded trip documents.
# Must match the mounted volume path in docker-compose files.
TRAVEL_FILES_ROOT=/app/data/travel-documents
# Maximum upload size in MB for a single document.
TRAVEL_FILES_MAX_MB=15
# Comma-separated allowlist of MIME types.
TRAVEL_FILES_ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/webp

# ── App Secrets ──────────────────────────────────────────────────────────────
ENCRYPTION_KEY=change_me_strong_random_base64_key

# ── Production deploy ────────────────────────────────────────────────────────
# GitHub Container Registry owner (your GitHub username or org)
# Required by docker-compose.prod.yml to pull images: ghcr.io/<IMAGE_OWNER>/...
IMAGE_OWNER=your_github_username

# ── CI/CD GitHub Secrets (not used locally) ─────────────────────────────────
# VPS_HOST       — IP or hostname of the production VPS
# VPS_USER       — SSH user (e.g. ubuntu)
# VPS_SSH_KEY    — private SSH key (RSA/Ed25519) with newlines preserved

# ── E2E Tests For local host only ───────────────────────────────────────────
# Marks this as a local machine — enables file writes in scripts like e2e:setup
# Never set this in Docker or CI environments
IS_LOCAL=false

# RapidAPI key for flight data APIs
RAPIDAPI_KEY=your_rapidapi_key_for_travel_data

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=your-db-backup-bucket-name

# SES Configs
SES_FROM_EMAIL=email@address.com

# E2E_HUB_BASE_URL=http://localhost:3000
# E2E_HUB_USER_EMAIL=e2e-hub@test.local
# E2E_HUB_USER_PASSWORD=your-e2e-test-user-password
# E2E_MCP_USER_EMAIL=e2e-mcp@test.local
# E2E_MCP_CLIENT_ID=e2e_test_client_id
# E2E_MCP_CLIENT_SECRET=e2e_test_client_secret
